{
  "name": "{{project_name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "security-audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.23.8",
    "@hono/zod-validator": "^0.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20241127.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.40.0"
  }
}
