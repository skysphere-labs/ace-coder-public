{
  // Cloudflare Workers config. Dev/prod separation via `env`; secrets are set
  // out-of-band (`wrangler secret put` locally, GitHub Environment secrets in CI).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{project_name}}",
  "main": "src/index.ts",
  "compatibility_date": "{{compat_date}}",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "development"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "{{project_name}}-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  "env": {
    "preview": {
      "vars": { "ENVIRONMENT": "preview" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "{{project_name}}-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/migrations"
        }
      ]
    },
    "production": {
      "vars": { "ENVIRONMENT": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "{{project_name}}-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/migrations"
        }
      ]
      // "routes": [{ "pattern": "api.example.com/*", "zone_name": "example.com" }]
    }
  }
}
