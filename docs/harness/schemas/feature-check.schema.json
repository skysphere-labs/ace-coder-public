{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ace.local/schemas/feature-check.schema.json",
  "title": "FeatureCheck",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "wave", "category", "priority", "description", "steps", "passes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "wave": { "type": "integer", "minimum": 0 },
    "category": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer", "minimum": 0 },
    "description": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "passes": { "type": "boolean" },
    "evidence": { "type": "string" },
    "lastRunId": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 }
  }
}
