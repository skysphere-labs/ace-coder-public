{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ace.local/schemas/memory-candidate.schema.json",
  "title": "MemoryCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceRunId", "category", "claim", "evidence", "confidence", "promoteToWiki"],
  "properties": {
    "schema": { "const": "ace.memory_candidate.v1" },
    "sourceRunId": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["decision", "lesson", "pitfall", "pattern", "project-fact", "connector-fact", "prompt-pattern"] },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "promoteToWiki": { "type": "boolean" },
    "targetWikiPage": { "type": "string", "minLength": 1 }
  }
}
