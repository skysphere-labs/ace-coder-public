{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ace.local/schemas/completion-result.schema.json",
  "title": "CompletionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "taskId", "handoffId", "outcome", "summary", "filesChanged", "commits", "testsRun", "acceptanceEvidence", "risks", "memoryCandidates"],
  "properties": {
    "schema": { "const": "ace.completion_result.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "handoffId": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "enum": ["done", "blocked", "awaiting-approval", "max-rounds", "done-unverified", "error"] },
    "summary": { "type": "string", "minLength": 1 },
    "filesChanged": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "commits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "testsRun": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail", "not-run"] },
          "outputDigest": { "type": "string" }
        }
      }
    },
    "acceptanceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail", "unknown"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "memoryCandidates": { "type": "array", "items": { "$ref": "memory-candidate.schema.json" } },
    "nextSuggestedTask": { "$ref": "task-spec.schema.json" }
  }
}
